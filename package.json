{
  "name": "bb-plugin-session-history",
  "version": "0.1.0",
  "private": true,
  "description": "Past Claude Code, Codex and Qwen Code sessions in BB, with the titles the agents gave them.",
  "license": "MIT",
  "author": "Nikolai Marchenko (https://github.com/neonick)",
  "homepage": "https://github.com/neonick/bb-plugin-session-history#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonick/bb-plugin-session-history.git"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "claude-code",
    "codex",
    "qwen-code",
    "sessions",
    "history"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Session History",
    "description": "Past Claude Code, Codex and Qwen Code sessions with their own titles, on the new-thread screen and a Sessions page with read-only transcripts.",
    "branding": {
      "icon": "Clock"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
